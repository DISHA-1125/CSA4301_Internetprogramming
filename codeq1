<!DOCTYPE html>
<html>
<head>
<title>Welcome to My Website</title>

<style>

body{
    margin:0;
    font-family:Cambria;
    font-size:14px;
    background-color:lightblue;
}

/* Header */
header{
    background:blue;
    color:white;
    padding:20px;
    text-align:center;
}

/* Navigation */
nav{
    background:#0047AB;
    padding:12px;
    text-align:center;
}

nav a{
    color:white;
    text-decoration:none;
    margin:20px;
    font-weight:bold;
}

/* Scrolling Text */
.scroll{
    background:white;
    color:blue;
    padding:10px;
    overflow:hidden;
    white-space:nowrap;
}

.scroll p{
    display:inline-block;
    animation:move 12s linear infinite;
    font-weight:bold;
}

@keyframes move{
    from{transform:translateX(100%);}
    to{transform:translateX(-100%);}
}

/* Image Slider */
.slider{
    overflow:hidden;
    margin:20px;
}

.slide-track{
    display:flex;
    width:max-content;
    animation:slide 18s linear infinite;
}

.slide-track img{
    width:250px;
    height:170px;
    margin:10px;
    border-radius:10px;
    border:3px solid blue;
}

@keyframes slide{
    from{transform:translateX(100%);}
    to{transform:translateX(-100%);}
}

/* Button */
button{
    background:blue;
    color:white;
    padding:12px 20px;
    border:none;
    border-radius:6px;
    font-size:14px;
    font-family:Cambria;
}

/* Grid */
.grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
    padding:20px;
}

.box{
    background:white;
    padding:20px;
    border-radius:10px;
    border:2px solid blue;
    text-align:center;
}

.box img{
    width:100%;
    height:150px;
    border-radius:8px;
}

/* About */
.about{
    background:white;
    margin:20px;
    padding:20px;
    border-radius:10px;
}

/* Footer */
footer{
    background:blue;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}

</style>

</head>

